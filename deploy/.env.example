# Copy to deploy/.env and fill in values (do not commit .env)

# Stable API token for the engine (min 16 chars). Required for compose.
# Generate: openssl rand -hex 32
NEOS_AUTH_TOKEN=change-me-to-a-long-random-secret

# Host port published by docker compose
NEOS_PORT=3000

# Optional: extra CORS origins (comma-separated)
# NEOS_CORS_ORIGINS=http://localhost:5173,https://app.example.com

# Optional: Host header allowlist when not using NEOS_ALLOW_ANY_HOST
# NEOS_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000,engine.example.com
