{
  "name": "@neos-work/office-sheets",
  "version": "0.10.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot.d.ts",
      "import": "./dist/snapshot.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@univerjs/preset-sheets-node-core": "1.0.2",
    "rxjs": "^7.8.0"
  },
  "peerDependencies": {
    "@univerjs/presets": "1.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@univerjs/presets": "1.0.2",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
