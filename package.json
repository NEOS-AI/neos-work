{
  "name": "neos-work",
  "private": true,
  "version": "0.8.1",
  "description": "An open-source alternative to Claude Cowork",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "typecheck": "turbo typecheck",
    "neos": "pnpm --filter @neos-work/cli exec node dist/index.js",
    "cli": "pnpm --filter @neos-work/cli start",
    "inventory": "node tools/inventory/inventory.mjs",
    "inventory:check": "node tools/inventory/inventory.mjs --check",
    "inventory:write": "node tools/inventory/inventory.mjs --write",
    "e2e:smoke": "node e2e/smoke/run.mjs",
    "e2e:live-smoke": "node e2e/live-smoke/run.mjs",
    "e2e:c5": "node e2e/c5-acceptance/run.mjs",
    "e2e:c5:docker": "node e2e/c5-acceptance/run.mjs --docker",
    "test:inventory": "node --test tools/inventory/inventory.test.mjs",
    "dev:server": "node tools/dev/dev.mjs start",
    "dev:server:stop": "node tools/dev/dev.mjs stop",
    "dev:server:status": "node tools/dev/dev.mjs status",
    "dev:server:logs": "node tools/dev/dev.mjs logs",
    "dev:web": "pnpm --filter @neos-work/web dev",
    "build:web": "pnpm --filter @neos-work/web build"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "eslint": "^9.27.0",
    "@eslint/js": "^9.27.0",
    "typescript-eslint": "^8.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.7.11",
    "turbo": "^2.5.0",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3",
      "protobufjs"
    ]
  }
}
